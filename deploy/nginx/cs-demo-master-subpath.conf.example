# Deploy under https://example.com/cs2/ while the backend still listens on 8000.
# Build the frontend with:
#   VITE_API_BASE_URL=/cs2/api/v1 pnpm build

server {
    listen 80;
    server_name _;

    client_max_body_size 60m;
    proxy_connect_timeout 10s;
    proxy_send_timeout 180s;
    proxy_read_timeout 180s;

    location /cs2/api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /cs2/uploads/ {
        proxy_pass http://127.0.0.1:8000/uploads/;
        proxy_set_header Host $host;
    }

    location /cs2/assets/ {
        alias /var/www/cs-demo-master/frontend/dist/assets/;
    }

    location /cs2/ {
        alias /var/www/cs-demo-master/frontend/dist/;
        try_files $uri $uri/ /cs2/index.html;
    }
}
