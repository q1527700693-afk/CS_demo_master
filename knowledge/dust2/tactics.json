        "min_rifles": 3,
        "needs_smoke": true,
        "needs_flash": true,
        "preferred_buy": [
          "full_buy",
          "force_with_rifles"
        ]
      },
      "required_utility": [
        "dust2_util_t_mid_fast_smoke",
        "dust2_util_t_a_long_flash"
      ],
      "optional_utility": [
        "dust2_util_t_a_long_smoke",
        "dust2_util_t_a_site_postplant_smoke"
      ],
      "steps": [
        {
          "order": 1,
          "role": "mid_smoker",
          "action": "throw_utility",
          "utility_id": "dust2_util_t_mid_fast_smoke",
          "deadline_seconds": 5.0,
          "zone_id": "t_spawn"
        },
        {
          "order": 2,
          "role": "a_long_entry",
          "action": "take_control",
          "zone_id": "long_doors",
          "deadline_seconds": 7.0
        },
        {
          "order": 3,
          "role": "flasher",
          "action": "throw_utility",
          "utility_id": "dust2_util_t_a_long_flash",
          "deadline_seconds": 8.0,
          "zone_id": "a_long"
        },
        {
          "order": 4,
          "role": "a_long_entry",
          "action": "enter_site",
          "zone_id": "a_site",
          "deadline_seconds": 10.0
        },
        {
          "order": 5,
          "role": "trade_player",
          "action": "trade",
          "max_delay_seconds": 3.0,
          "zone_id": "a_long_pit"
        },
        {
          "order": 6,
          "role": "postplant",
          "action": "plant_then_hold",
          "zone_id": "a_site"
        }
      ],
      "success_conditions": [
        "mid_smoke_bloomed_before_entry",
        "a_long_flash_created_entry_window",
        "entry_won_or_was_traded",
        "team_entered_site_or_planted"
      ],
      "failure_modes": [
        {
          "code": "late_mid_smoke",
          "description": "中门烟在 A 大进点后才生效。"
        },
        {
          "code": "wasted_a_long_flash",
          "description": "A 大闪没有致盲防守者，或闪到进点队友。"
        },
        {
          "code": "untraded_entry_death",
          "description": "第一身位死亡后无人及时补枪。"
        },
        {
          "code": "mid_awp_untouched",
          "description": "中门方向仍可直接架住 A 大过点。"
        }
      ],
      "detection_rules": [
        "至少 3 名 T 在前 10 秒进入 A 大/长门区域。",
        "中门快烟在 A 大第一次交火前出现。",
        "A 大方向出现第一交火，且队伍目标明显偏向 A 包点。"
      ],
      "adaptations": [
        {
          "when": "opponent_rotates_fast_to_a",
          "recommendation": "保留 A 大压力，改由 2 人转 B 或第二时间再爆 A。",
          "evidence_required": [
            "ct_rotation_time",
            "a_long_contact"
          ]
        },
        {
          "when": "opponent_has_mid_awp_and_no_smoke_available",
          "recommendation": "不硬抢 A 大，改为中路默认或 B 洞施压。",
          "evidence_required": [
            "enemy_awp_position",
            "our_smoke_inventory"
          ]
        },
        {
          "when": "a_long_first_spawn_lost",
          "recommendation": "放弃第一时间 A 大，转 A 小夹 A 或 B 洞快打。",
          "evidence_required": [
            "round_start_spawn_distances"
          ]
        }
      ],
      "confidence": "draft",
      "needs_validation": true,
      "source_refs": [
        "expert_draft",
        "community_callouts",
        "awpy_docs"
      ]
    },
