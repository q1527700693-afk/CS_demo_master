{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "stage": {
      "enum": [
        "local",
        "upload",
        "cloud",
        "download"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "completed",
        "skipped",
        "failed"
      ]
    },
    "percent": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "stage",
    "status",
    "percent",
    "message"
  ],
  "additionalProperties": false
}
