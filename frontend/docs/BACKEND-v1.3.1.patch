+def collect_utility_throws(demo: Any, index: RoundIndex, rounds: list[dict[str, Any]],
+                           truncated: list[str], warnings: list[str]) -> tuple[list[dict[str, Any]], bool]:
+    """One normalized weapon_fire per thrown grenade; never count victims or damage."""
+    try:
+        frame = demo.shots
+        types = {"flashbang", "smokegrenade", "hegrenade", "molotov", "incgrenade", "decoy"}
+        by_round = {r["round_num"]: r for r in rounds if not r.get("is_knife_round")}
+        output = []
+        seen = set()
+        for row in frame.to_dicts():
+            weapon = str(row.get("weapon") or "").removeprefix("weapon_")
+            sid = steamid(row.get("steamid"))
+            tick = row.get("tick")
+            if weapon not in types or not sid or not isinstance(tick, (int, float)):
+                continue
+            rn = index.at(tick)
+            current = by_round.get(rn)
+            if not current or (current.get("freeze_end_tick") is not None and tick < current["freeze_end_tick"]):
+                continue
+            key = (sid, tick, weapon)
+            if key in seen:
+                continue
+            seen.add(key)
+            output.append({"event_id": f"throw_{len(output)+1:04d}", "tick": tick,
+                           "round_num": rn, "steamid": sid, "weapon": weapon})
+            if len(output) >= MAX_GRENADES:
+                truncated.append("utility_throws")
+                return output, False
+        return output, True
+    except Exception as error:
+        warnings.append(f"utility throws unavailable: {error}")
+        return [], False
+
