+        if (a <= 2500 && b >= 3500 && a <= b*0.65 && won)
+            find('eco_win',anchor,'我方人均装备 $'+Math.round(a)+'，对方 $'+Math.round(b)+'，经济劣势下获胜。','回看如何通过首杀、缴枪和协同创造翻盘。',true);
+        if (b <= 2500 && a >= 3500 && b <= a*0.65 && !won && SIDES.has(r.winner_side))
+            find('anti_eco_loss',anchor,'我方人均装备 $'+Math.round(a)+'，对方 $'+Math.round(b)+'，装备优势局被翻盘。','回看武器距离、补枪与丢枪后的处理，避免逐个接敌。');
+    }
+    const utility = {he_damage:0,fire_damage:0,utility_team_damage:0,utility_unclassified_damage:0};
+    let rawFallback = false;
+    const enrichedDamage = [];
+    for (const d of payload.damages || []) {
+        const e = {...d,attacker_side:d.attacker_side || sideOf(d.round_num,d.attacker_steamid),
