+            (r.end_tick == null || e.tick <= r.end_tick);
+    };
+    const kills = (payload.kills || []).filter(live).sort((a,b) => a.tick-b.tick);
+    const hostile = kills.filter(e => relation(e) === 'enemy');
+    const ownKills = hostile.filter(e => String(e.attacker_steamid) === targetId);
+    const ownDeaths = kills.filter(e => String(e.victim_steamid) === targetId);
+    const stat = (payload.stats || []).find(s => String(s.steamid) === targetId) || {};
+    const findings = [], perRound = [];
