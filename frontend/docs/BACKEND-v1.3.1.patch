+'use strict';
+const TYPES=['flashbang','smokegrenade','hegrenade','molotov','incgrenade','decoy'];
+function utilityWeapon(value) {
+    const key=String(value||'').toLowerCase().replace(/^weapon_/,'');
+    return ({flash:'flashbang',smoke:'smokegrenade',he:'hegrenade',incendiary:'incgrenade'})[key] ||
+        (TYPES.includes(key)?key:null);
+}
+function utilityThrows(payload,targetId) {
+    const counts=Object.fromEntries(TYPES.map(k=>[k,0]));
+    const recorded=Array.isArray(payload.utility_throws);
+    const complete=recorded && payload.utility_throws_complete===true &&
+        !(payload.truncated||[]).includes('utility_throws');
+    const seen=new Set();
+    if(recorded) for(const e of payload.utility_throws) {
+        const weapon=utilityWeapon(e.weapon);
+        if(!weapon || String(e.steamid)!==String(targetId) || !Number.isFinite(e.tick))continue;
+        const key=[e.steamid,e.tick,weapon].join(':');
+        if(seen.has(key))continue;
+        seen.add(key);counts[weapon]++;
+    }
+    // A damage row, flash victim, or unowned trajectory never proves a throw.
+    const stat=(payload.stats||[]).find(s=>String(s.steamid)===String(targetId));
+    return {
+        source:recorded?'weapon_fire':null,complete,
+        items:TYPES.map(weapon=>({
+            weapon,throws:complete?counts[weapon]:recorded&&counts[weapon]>0?counts[weapon]:
+                weapon==='flashbang'&&Number.isFinite(stat?.flashes_thrown)?stat.flashes_thrown:null,
+            lower_bound:recorded&&!complete&&counts[weapon]>0
+        }))
+    };
+}
+module.exports={utilityWeapon,utilityThrows};
