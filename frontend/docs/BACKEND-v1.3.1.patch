+        else if (sides.get(key) !== side) sides.set(key, null);
+    }
+    for (const s of payload.all_player_samples || []) observe(s.round_num, s.steamid, s.side);
+    for (const s of payload.target_samples || []) observe(s.round_num, s.steamid || targetId, s.side);
+    for (const e of [...(payload.kills || []), ...(payload.damages || []), ...(payload.blinds || [])]) {
+        observe(e.round_num, e.attacker_steamid, e.attacker_side);
+        observe(e.round_num, e.victim_steamid, e.victim_side);
