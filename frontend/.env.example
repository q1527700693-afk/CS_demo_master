# Dev requests go through Vite's proxy. These values are public browser config.
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000
# Disable individual mock modules only after the corresponding backend is ready.
VITE_MOCK_AUTH=false
VITE_MOCK_PROFILE=false
VITE_MOCK_REPLAY=false
# Friends/lobbies always use real APIs; legacy VITE_MOCK_LOBBY is ignored.
VITE_LOCAL_PARSER_URL=http://127.0.0.1:8877

# Optional module entry switches. Change then restart dev / rebuild production.
VITE_FEATURE_REPLAY=true
VITE_FEATURE_PROFILE=true
VITE_FEATURE_LOBBY=true
VITE_FEATURE_TRAINING=true
VITE_FEATURE_SOCIAL=true

