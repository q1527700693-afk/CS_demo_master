# Copy to .env and adjust. All variables are optional for local development.

# HTTP port (backend listens on it; Nginx proxies to it in production)
PORT=8000

# JWT signing secret - MUST be changed before deploying
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite file (created automatically). Relative to the backend/ directory.
DB_PATH=./data/app.db

# Where avatars are written. Served on /uploads/avatars/...
UPLOAD_DIR=./uploads

# Lobby posts expire after this many hours (default 24, max 8760).
LOBBY_TTL_HOURS=24
# Optional: private replay storage, outside public uploads/static directories.
# REPLAY_DIR=/var/lib/cs-demo-master/replays

# --- AI analysis (optional) ---
# Leave empty to keep the AI endpoint disabled. Configure these only on the server.
DEEPSEEK_API_KEY=
# OpenAI-compatible base URL. Use https://api.deepseek.com or an API-compatible gateway.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=2000
AI_PROMPT_VERSION=coach-1.0.0
# Generate the AI coach automatically once a demo report is ready (costs a provider call).
AI_AUTO_ANALYZE=false

# --- Demo file parser (raw .dem uploads) ---
# Optional: pin the interpreter that has awpy installed. Without it the backend
# probes parser/.venv, then python.exe / python3 on PATH.
# DEMO_PARSER_PYTHON=C:\Python313\python.exe
# Optional: override the parser script path.
# DEMO_PARSER_SCRIPT=../parser/parse_demo.py
# Optional: extra PYTHONPATH for a "pip install --target .pydeps" layout.
# DEMO_PARSER_PYTHONPATH=../parser/.pydeps
# Wall-clock budget for one demo parse (milliseconds).
DEMO_PARSER_TIMEOUT_MS=300000
